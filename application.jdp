pipeline {
    agent any
      stages {
     
        stage('PULL') {
            steps {
                git branch: 'kube', url: 'https://github.com/yogeshgadwar10/EasyCRUD.git'                
            }
        }
        stage('FRONTEND-DOCKER-BUILD') {
            steps {
                
                //    sh '''cd frontend && \
                //    docker build . -t yogeshgadwar/frontend:latest'''
                   sh '''cd frontend
                    docker build . -t yogeshgadwar/easy-frontend:latest'''

                   
                // sh 'cd /var/lib/jenkins/workspace/studnet-app/frontend && docker build . -t yogeshgadwar/frontend:latest'
            }
        }
        stage('BACKEND-DOCKER-BUILD') {
            steps {
                sh '''cd backend 
                 docker build . -t yogeshgadwar/backend:latest'''
            }
        }
        stage('PUSH-DOCKER-HUB-FRONTEND') {
            steps {
                sh 'docker push yogeshgadwar/frontend:latest'
            }
        }
        stage('PUSH-DOCKER-HUB-FRONTEND') {
            steps {
                sh 'docker push yogeshgadwar/backend:latest'
            }
        }

        stage('CLEAN') {
            steps {
                sh '''docker rmi -f yogeshgadwar/frontend:latest
                      docker rmi -f yogeshgadwar/backend:latest'''
            }
        }
        stage('DEPLOY') {
            steps {
                sh 'kubectl apply -f SHORT_KUBE_YAMLS'
            }
        }
    }
}