pipeline {
    agent any
      stages {
     
        stage('Cleanup') {
            steps {
                sh 'rm -f unwanted-file.txt'
                // or for Windows: bat 'del unwanted-file.txt'
            }
        }
        stage('PULL') {
            steps {
                git branch: 'dev', url: 'https://github.com/yogeshgadwar10/jenkins.git'

            }
        }
         stage('init') {
            steps {
                sh '''
                       terraform init'''
            }
        }
        stage('PLAN') {
            steps {
                sh '''
                    terraform plan'''
            }
        }
        stage('APPROVE') {
            steps {
                timeout(1) {
                input message: 'Approve is required : shall we proceed ?', ok: "Approve"
            }

            }
        }
         stage('APPLY') {
            steps {
                sh 'terraform apply --auto-approve'
            }
        }
        
    }
}