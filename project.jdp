pipeline {
    agent any
    stages {
        stage('PULL') {
            steps {
                git branch: 'kube', url: 'https://github.com/yogeshgadwar10/EasyCRUD.git'
            }
        }
        stage('BUILD') {
            steps {
               sh '''cd backend
                     mvn clean package -DskipTests'''
            }
        }
        stage('TEST') {
            steps {
                withSonarQubeEnv(installationName: 'sonarqube', credentialsId: 'sonar-cred')
                   {
                   cd backend
                   mvn sonar:sonar -Dsonar.projectKey=studentapp
            

    
                }
            }
        }
        stage('DEPLOY') {
            steps {
               echo 'Deploy SUCCESSFUL'
            }
        }
    }
 
}
                    
